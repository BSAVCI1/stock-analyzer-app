# Non-secret deployment settings
BSAVCI_DATABASE_PATH=/app/data/paper_trading.db
BSAVCI_HEARTBEAT_PATH=/app/data/worker-heartbeat.json
BSAVCI_BACKUP_DIRECTORY=/app/data/backups
BSAVCI_HEALTH_PORT=8080
BSAVCI_HEARTBEAT_MAX_AGE_SECONDS=900
BSAVCI_WORKER_INTERVAL_SECONDS=900
BSAVCI_WORKER_RUN_IMMEDIATELY=true
BSAVCI_RUN_KEY_PREFIX=managed

# Managed secret-file references
# Create these files outside the repository and mount them read-only.
PAPER_TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
PAPER_SMTP_PASSWORD_FILE=/run/secrets/smtp_password

# Non-secret notification settings
PAPER_TELEGRAM_CHAT_ID=
PAPER_SMTP_HOST=
PAPER_SMTP_PORT=587
PAPER_SMTP_USERNAME=
PAPER_EMAIL_FROM=
PAPER_EMAIL_TO=
PAPER_SMTP_STARTTLS=true
PAPER_SMTP_SSL=false
