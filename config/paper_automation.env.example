# Persistent SQLite portfolio database.
PAPER_DATABASE_PATH=data/paper_trading.db

# Existing paper account identifier.
PAPER_ACCOUNT_ID=ACC-REPLACE-ME

# Scanner universe configuration.
PAPER_UNIVERSE_PATH=config/stock_universe.json

# Deny-all by default.
# Add only strategies that have completed the
# project release-gate process.
PAPER_RELEASE_ELIGIBLE_STRATEGIES=trend_pullback

PAPER_APP_VERSION=v0.3.4-p3.4
PAPER_THRESHOLD_VERSION=schema-1

# Optional Telegram delivery.
# PAPER_TELEGRAM_BOT_TOKEN=
# PAPER_TELEGRAM_CHAT_ID=
# PAPER_TELEGRAM_TIMEOUT=15

# Optional SMTP delivery.
# PAPER_SMTP_HOST=smtp.example.com
# PAPER_SMTP_PORT=587
# PAPER_SMTP_USERNAME=
# PAPER_SMTP_PASSWORD=
# PAPER_SMTP_STARTTLS=true
# PAPER_SMTP_SSL=false
# PAPER_SMTP_TIMEOUT=20
# PAPER_EMAIL_FROM=paper@example.com
# PAPER_EMAIL_TO=recipient@example.com
